CONFIG_BOOTCOMMAND="run mmc_boot"
CONFIG_CMD_EEPROM=y
# CONFIG_CMD_FRU is not set
CONFIG_CMD_NVEDIT_LOAD=y
CONFIG_ENV_IS_IN_EEPROM=y
CONFIG_ENV_OFFSET=0x1800
# CONFIG_ENV_REDUNDANT is not set
CONFIG_ENV_SIZE=0x800
CONFIG_PHY_ANEG_TIMEOUT=10000
CONFIG_PHY_LANTIQ=y
CONFIG_PREBOOT="run prebootcmd"
CONFIG_SPL_I2C=y
CONFIG_SPL_I2C_EEPROM=y
CONFIG_SPL_NVMEM=y
CONFIG_SYS_EEPROM_PAGE_WRITE_BITS=5
CONFIG_SYS_I2C_EEPROM_ADDR=0x50
CONFIG_SYS_I2C_EEPROM_ADDR_LEN=2
